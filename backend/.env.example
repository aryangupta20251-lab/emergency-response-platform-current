PORT=5000
# Development defaults to 0.0.0.0 for trusted LAN testing; production defaults to 127.0.0.1.
# Set HOST explicitly when running behind a production reverse proxy/container.
# Add the PC's LAN frontend origin here for phone testing.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=
# npm test uses only this separate disposable database; its name must include "test".
TEST_DATABASE_URL=
# Set a unique random secret of at least 32 bytes in .env.
JWT_SECRET=
JWT_EXPIRES_IN=1h
NODE_ENV=development
PASSWORD_RESET_DELIVERY=console
# Set to the web application's reset route; local development console links are not public delivery.
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Production requires a configured webhook transport or password reset remains unavailable.
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_WEBHOOK_TOKEN=