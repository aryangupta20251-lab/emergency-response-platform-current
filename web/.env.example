# Browser-visible key: restrict it in Google Cloud to approved website referrers
# and the Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: set only when you need a fixed API host. In Vite development,
# the API/Socket.IO host otherwise follows the host used to open the web app.
# VITE_API_BASE_URL=http://localhost:5000/api
